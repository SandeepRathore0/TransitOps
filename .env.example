# Copy to .env (never commit .env) and fill in real values.

# MySQL/MariaDB connection string. URL-encode special characters in the password.
DATABASE_URL=mysql+pymysql://transitops:CHANGE_ME@localhost:3306/transitops

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# development | production  (production hides the interactive API docs)
ENVIRONMENT=development

# Browser origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Token lifetime in minutes (default 8 hours) and for "Remember me" (days)
ACCESS_TOKEN_EXPIRE_MINUTES=480
REMEMBER_ME_DAYS=7

# Account lock after N failed sign-ins, for M minutes (a Fleet Manager can unlock sooner)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Fallback fuel price (INR/litre) when a trip is completed without one
DEFAULT_FUEL_PRICE_PER_LITER=100

# First account created by seed_db.py (role: Fleet Manager - owns Settings and the team).
# If ADMIN_PASSWORD is empty a random one is generated and printed once.
ADMIN_NAME=Depot Manager
ADMIN_EMAIL=admin@transitops.com
ADMIN_PASSWORD=

# Only for `seed_db.py --mock`: password of the three demo users (Dispatcher, Safety Officer, Financial Analyst).
# If empty a random one is generated and printed once.
DEMO_PASSWORD=

# Set true ONLY behind a trusted reverse proxy (uses X-Forwarded-For for audit IPs)
TRUST_PROXY_HEADERS=false
